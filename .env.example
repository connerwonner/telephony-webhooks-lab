# Copy to .env.local (never commit). Placeholders only.
TWILIO_AUTH_TOKEN=
# Exact public origin Twilio calls, no trailing slash. Must match the console URL.
PUBLIC_BASE_URL=https://your-tunnel.example
# Outbound SMS is OFF unless exactly "true"
SMS_ENABLED=false
# Comma-separated E.164 numbers that have explicitly consented
SMS_CONSENT_NUMBERS=
TWILIO_ACCOUNT_SID=
TWILIO_FROM_NUMBER=
